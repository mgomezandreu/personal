---
import { withBase } from "@lib/utils";

type Props = {
  src: string;
  alt: string;
};

const { src, alt } = Astro.props;
---

{/* Fixed-size light chip: keeps every mark the same visual weight, keeps the
    text column aligned, and keeps dark marks legible on the dark-first theme. */}
<span class="shrink-0 inline-flex h-11 w-28 items-center justify-center rounded-md bg-white px-2 py-1 ring-1 ring-black/10 dark:ring-white/15">
  <img
    src={withBase(src)}
    alt={alt}
    class="max-h-full max-w-full w-auto object-contain"
    loading="lazy"
    decoding="async"
  />
</span>
