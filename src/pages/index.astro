---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import ExperienceList from "@components/ExperienceList.astro";
import { experience } from "@data/experience";
import { publications } from "@data/publications";
import { SITE, HOME, SOCIALS } from "@consts";

const featuredPublications = publications.slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Mario <span class="text-xl">👋</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I think intelligence develops through interaction with the physical world.
            That is why I work on robots.
          </p>
          <p class="animate">
            I'm a visiting student at the
            <Link href="https://www.cam.ac.uk/" external>University of Cambridge</Link>,
            where I'm writing my master's thesis, and an incoming PhD student at
            <Link href="https://ethz.ch/en.html" external>ETH Zürich</Link>'s
            <Link href="https://cvg.ethz.ch/" external>Computer Vision and Geometry Group</Link>.
            My research spans motion planning, control, and 3D perception, from trajectory
            optimization on Gaussian Splats to MPC for excavators in the field.
          </p>
          <p class="animate">
            Running, rowing, Salsa Cubana, and good arguments fill the rest. Say hello.
          </p>
        </article>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Experience
        </h5>
        <ExperienceList items={experience} />
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Publications
          </h5>
          <Link href="/publications">
            See all publications
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {featuredPublications.map(pub => (
            <li class="space-y-1">
              <div class="font-semibold text-black dark:text-white">
                <Link href="/publications">{pub.title}</Link>
              </div>
              <div class="text-sm italic opacity-75">{pub.venue}</div>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch about research, a project, or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
